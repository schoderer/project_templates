# Copy to .env (gitignored); just loads it for every recipe.

# Use only these GPUs (comma-separated UUIDs from `just gpu-info`). Set this to the dedicated card
# to hide an integrated GPU, which ROCm doesn't support and `device_map="auto"` would otherwise use.
#ROCR_VISIBLE_DEVICES=GPU-0123456789abcdef

# Token for gated / private Hugging Face models
#HF_TOKEN=hf_...
