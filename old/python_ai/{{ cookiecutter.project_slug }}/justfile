set positional-arguments
# .env: per-project settings such as ROCR_VISIBLE_DEVICES and HF_TOKEN (see .env.example)
set dotenv-load

export IMAGE := "{{ cookiecutter.project_slug }}-rocm"
export HF_CACHE := env_var_or_default("HF_HOME", env_var("HOME") / ".cache/huggingface")

default:
  just --list

# Build the ROCm container image (rocm/pytorch + uv)
build-image:
  podman build -t "$IMAGE" .

# Run a python script in the ROCm container, e.g. `just run examples/transcribe.py talk.mp3`
run script *args:
  @just _podman python "$@"

# Run any command in the ROCm container, e.g. `just exec hf download openai/whisper-small`
exec *cmd:
  @just _podman "$@"

# Interactive shell in the ROCm container (project venv active via `uv run`)
shell:
  @just _podman bash

# Show all GPUs with their UUIDs (ignores ROCR_VISIBLE_DEVICES, so hidden ones are listed too)
gpu-info:
  @ROCR_VISIBLE_DEVICES= just _podman bash scripts/gpu-info.sh

# Drop the container venv (rebuilt on the next run)
reset-venv:
  podman volume rm -f {{ cookiecutter.project_slug }}-venv

# Host: install deps into .venv (CPU torch, for ty and editors)
sync:
  uv sync

# Host: type check
check:
  uv run --no-sync ty check

# Host: format and lint
fmt:
  ruff format .
  ruff check --fix .

# Optional env (shell or .env): ROCR_VISIBLE_DEVICES (GPU UUIDs to use), HIP_VISIBLE_DEVICES,
# HSA_OVERRIDE_GFX_VERSION (unsupported GPUs), HF_TOKEN
[private]
_podman *cmd:
  @mkdir -p "$HF_CACHE"
  podman run --rm --interactive $([ -t 0 ] && echo --tty) \
    --device /dev/kfd --device /dev/dri \
    --group-add keep-groups \
    --security-opt seccomp=unconfined \
    --ipc=host \
    -v "$PWD":/workspace:Z \
    -v {{ cookiecutter.project_slug }}-venv:/opt/project-venv \
    -v {{ cookiecutter.project_slug }}-uvcache:/opt/uv-cache \
    -v "$HF_CACHE":/root/.cache/huggingface:z \
    ${HSA_OVERRIDE_GFX_VERSION:+-e HSA_OVERRIDE_GFX_VERSION} \
    ${ROCR_VISIBLE_DEVICES:+-e ROCR_VISIBLE_DEVICES} \
    ${HIP_VISIBLE_DEVICES:+-e HIP_VISIBLE_DEVICES} \
    ${HF_TOKEN:+-e HF_TOKEN} \
    "$IMAGE" "$@"
