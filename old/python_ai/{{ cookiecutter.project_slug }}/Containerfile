# ROCm runtime + the image's own ROCm build of torch, plus uv.
# The image's py3.X must match python314 in flake.nix and requires-python in pyproject.toml.
ARG ROCM_IMAGE={{ cookiecutter.rocm_image }}
FROM ${ROCM_IMAGE}

# ffmpeg: audio decoding for speech-recognition pipelines; libgl1/libglib2.0-0: OpenCV runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /uvx /usr/local/bin/

# The project venv lives outside the mounted project (on a named volume), so it never
# collides with the host's .venv, which is built against the Nix python.
ENV UV_PROJECT_ENVIRONMENT=/opt/project-venv \
    UV_CACHE_DIR=/opt/uv-cache \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy

COPY container-entrypoint.sh /usr/local/bin/container-entrypoint.sh
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/container-entrypoint.sh"]
CMD ["python", "gpu_check.py"]
