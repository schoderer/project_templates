default:
  just --list


build:
  nix build .#default

perf:
  perf record --call-graph dwarf cargo run --release # Debugsymbols need to be included
  perf report -g

build-docker:
  nix build .#dockerImage

dive-inspect:
  gunzip --stdout result > /tmp/image.tar && dive docker-archive:///tmp/image.tar
