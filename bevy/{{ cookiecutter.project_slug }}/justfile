default:
  just --list

# Main dev loop: dynamic linking + dev tools + asset hot-reload.
run:
  cargo run --features dev

# Without dynamic linking. Note this is a separate feature set, so the first
# run after switching rebuilds the dependency graph.
run-static:
  cargo run

run-release:
  cargo run --release

# Fastest possible feedback: type-check only, no codegen and no linking.
check:
  cargo check --features dev

# Continuous check/clippy TUI. Leave this open in a second pane while you work.
watch:
  bacon

# Edit system bodies while the game is running.
# Needs the dioxus CLI: cargo install dioxus-cli
hotpatch:
  dx serve --hot-patch --features hotpatch

fmt:
  cargo fmt

lint:
  cargo clippy --features dev --all-targets

test:
  cargo test

# Reproducible release build.
build:
  nix build .#default

# Find out what is actually slow: writes target/cargo-timings/cargo-timing.html
timings:
  cargo build --features dev --timings

clean:
  cargo clean
