default:
  just --list

# Format everything per treefmt.toml
fmt:
  treefmt

run *ARGS:
  cargo run -- {{ARGS}}

test:
  cargo test

lint:
  cargo clippy --all-targets -- --deny warnings

# Reproducible build -> result/bin/<name>
build:
  nix build .#default

build-docker:
  nix build .#dockerImage
