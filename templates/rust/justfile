default:
  just --list

# Format everything per treefmt.toml
fmt:
  treefmt

run *ARGS:
  cargo run -- {{ARGS}}

test:
  cargo test

lint:
  cargo clippy --all-targets -- --deny warnings

# Reproducible build -> result/bin/<name>
build:
  nix build .#default

build-docker:
  nix build .#dockerImage

# Profile with perf (the `perf` profile in Cargo.toml keeps debug symbols)
perf:
  perf record --call-graph dwarf cargo run --profile perf

perf-report:
  perf report -g
