default:
  just --list

# Format everything per treefmt.toml
fmt:
  treefmt

run *ARGS:
  uv run app {{ARGS}}

test:
  uv run pytest

lint:
  ruff check

typecheck:
  ty check

# Reproducible build -> result/bin/<script>
build:
  nix build .#default

build-docker:
  nix build .#dockerImage

# Create/refresh .venv from uv.lock
sync:
  uv sync
