# Shortcuts for the common nix commands. Run `just` to list recipes.
# `just` is included in the root dev shell (`nix develop`).

# Nix flags shared by every recipe, e.g. `just flags=-L check` for full logs.
flags := ""

# List available recipes
default:
    @just --list --unsorted

# Build every binary, or one project's binary (`just build my-cli`)
build project="default":
    nix build {{ flags }} .#{{ project }}

# Build every service docker image, or one service's (`just docker my-api`)
docker service="":
    nix build {{ flags }} .#{{ if service == "" { "docker" } else { service + "-docker" } }}

# Build all binaries and all docker images
build-all:
    nix build {{ flags }} .#default .#docker

# Run every check (clippy, tests, linters, formatting, builds)
check:
    nix flake check {{ flags }}

# Run one check, e.g. `just check-one my-api-clippy`
check-one name:
    nix build {{ flags }} .#checks.$(nix eval --raw --impure --expr builtins.currentSystem).{{ name }}

# Format nix and shell files plus every language used by a project (treefmt)
fmt:
    nix fmt

# Run a project's binary, e.g. `just run my-cli greet nix`
run project *args:
    nix run {{ flags }} .#{{ project }} -- {{ args }}

# Enter the dev shell of every project, or of one (`just dev my-api`)
dev project="default":
    nix develop .#{{ project }}

# Build all service images and load them into docker
docker-load:
    nix run .#docker-load

# Run every service locally with docker compose, e.g. `just up -d`
up *args:
    nix run .#up -- {{ args }}

# Stop the services started by `just up`
down:
    nix run .#down

# List the languages available for new services and tools
templates:
    @echo "services: $(ls templates/services | xargs)"
    @echo "tools:    $(ls templates/tools | xargs)"

# Scaffold services/<name>, e.g. `just new-service go my-api`
new-service lang name:
    nix run .#new-service -- {{ lang }} {{ name }}

# Scaffold tools/<name>, e.g. `just new-tool python my-cli`
new-tool lang name:
    nix run .#new-tool -- {{ lang }} {{ name }}

# Update root inputs, then pin every project flake.lock to them
update:
    nix flake update
    nix run .#sync-locks

# Pin every project flake.lock to the root flake.lock
sync-locks:
    nix run .#sync-locks

# Show every flake output
show:
    nix flake show

# Everything CI runs
ci: && build-all
    nix run .#sync-locks -- --check
    nix flake check {{ flags }}

# Remove result symlinks and local build/cache directories
clean:
    rm -rf result result-*
    find . -path ./.git -prune -o \( -name target -o -name __pycache__ -o -name .pytest_cache -o -name .mypy_cache -o -name .ruff_cache \) -prune -exec rm -rf {} +
